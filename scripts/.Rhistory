mat <- lc_vcv_list[[i]]
name <- names(lc_vcv_list)[i]
if(name=="evolutionary"){
res <- mclapply(
mat,
calcAIRMEvoVCV,
mc.cores = detectCores()-1
)
}else{
res <- mclapply(
mat,
calcAIRMIntraVCV,
mc.cores = detectCores()-1
)
}
saveRDS(res,
paste0(paste0(input, "lc/phylopars/",
name,
"_AIRM_distances.rds")))
}
View(ui2_data)
